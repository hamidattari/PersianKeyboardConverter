<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>PersianKeyboardConverter</AssemblyName>
    <RootNamespace>PersianKeyboardConverter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Forms\HotkeyPickerForm.Designer.cs~RF2e6060ac.TMP" />
  </ItemGroup>

  <ItemGroup>
    <!-- UIAutomationClient lives in Microsoft.WindowsDesktop.App; reference it directly -->
    <Reference Include="UIAutomationClient">
      <HintPath>$(MSBuildProgramFiles32)\dotnet\packs\Microsoft.WindowsDesktop.App.Ref\8.0.20\ref\net8.0\UIAutomationClient.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UIAutomationTypes">
      <HintPath>$(MSBuildProgramFiles32)\dotnet\packs\Microsoft.WindowsDesktop.App.Ref\8.0.20\ref\net8.0\UIAutomationTypes.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>