<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WindowsBase (System.Windows.Rect from TextPatternRange.GetBoundingRectangles)
         is part of the WPF framework surface; enable it without any WPF runtime use. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>PersianKeyboardConverter</AssemblyName>
    <RootNamespace>PersianKeyboardConverter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Forms\HotkeyPickerForm.Designer.cs~RF2e6060ac.TMP" />
  </ItemGroup>

  <!-- Scratch harness area (repro/). Keep it out of the default **/*.cs glob:
       its own obj/ contains generated .cs files that would otherwise be
       compiled into this assembly and duplicate its assembly attributes. -->
  <ItemGroup>
    <Compile Remove="repro\**" />
    <None Remove="repro\**" />
    <EmbeddedResource Remove="repro\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>